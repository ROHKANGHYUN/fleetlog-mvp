{
  "name": "fleetlog-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node services/api/src/server.mjs",
    "dev:web": "npm run dev --workspace @fleetlog/web",
    "build": "npm run build --workspace @fleetlog/web",
    "start": "node services/api/src/server.mjs",
    "test": "node --test packages/contracts/*.test.mjs packages/domain/*.test.mjs services/api/test/*.test.mjs tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:mvp": "npm run build && node scripts/demo-mvp.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
